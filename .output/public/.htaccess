<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Deixar o script PHP de envio de email ser executado diretamente
  RewriteRule ^api/ - [L]

  # Se o ficheiro ou pasta física existir, servir diretamente (css, js, imagens, etc)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirecionar todas as outras rotas SPA para o index.html
  RewriteRule ^ index.html [L]
</IfModule>
